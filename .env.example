# ---------------------------------------------------------------
# Becris Detailer LLC – Meta lead alerts
# Copy to .env (local) or paste into your host's env settings.
# Every notification channel is optional: fill in the ones you want.
# ---------------------------------------------------------------

PORT=3000

# --- Meta (Facebook) ---------------------------------------------
# Any random string. You paste the same value into the Meta app's
# Webhooks "Verify token" box.
META_VERIFY_TOKEN=change-me-to-a-random-string
# Meta app → Settings → Basic → App secret. Used to verify that
# webhook calls really come from Meta.
META_APP_SECRET=
# Long-lived Page access token for "Becris Detailer LLC" with the
# leads_retrieval + pages_manage_metadata + pages_show_list permissions.
META_PAGE_ACCESS_TOKEN=
# Becris Detailer LLC Facebook Page ID.
META_PAGE_ID=1146970505169606
GRAPH_API_VERSION=v23.0

# --- Branding / formatting ---------------------------------------
BUSINESS_NAME=Becris Detailer
# Timezone used for the "received at" time in alerts.
LEAD_TIMEZONE=America/New_York

# --- SMS via Twilio (recommended – fastest to notice) ------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 format, e.g. +15715550123
TWILIO_FROM_NUMBER=
# Who gets the text. Comma-separate for more than one phone.
ALERT_SMS_TO=

# --- Email via Resend (https://resend.com) -----------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, or onboarding@resend.dev for testing.
ALERT_EMAIL_FROM=Lead Alerts <onboarding@resend.dev>
# Comma-separate for more than one inbox.
ALERT_EMAIL_TO=

# --- Telegram (free push notifications) --------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separate for more than one chat.
TELEGRAM_CHAT_ID=
